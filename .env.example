# Environment variables for Transportation Forms
# Copy this file to .env and fill in values for your environment.
# The .env file is gitignored and must NEVER be committed.

# PostgreSQL
POSTGRES_USER=transportation
POSTGRES_PASSWORD=change-me-in-production
POSTGRES_DB=transportation_forms

# MinIO S3-compatible object storage
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=change-me-in-production
