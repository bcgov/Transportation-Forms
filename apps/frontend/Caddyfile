{
	# Disable the Caddy admin API – not required in containers.
	admin off

	# OpenShift handles TLS termination at the route level; Caddy runs plain HTTP.
	auto_https off

	# Ensure coraza_waf runs before other handlers
	order coraza_waf first
}

# ── Primary port: static files + WAF + API reverse proxy ─────────────────────
:3000 {
	# Coraza WAF – OWASP Core Rule Set
	coraza_waf {
		load_owasp_crs
		directives `
			Include /etc/caddy/coraza.conf
		`
	}

	# Liveness / readiness probe handled by dedicated health port (no WAF overhead)

	# Reverse-proxy all /api/* and /auth/* requests to the backend
	handle /api/* {
		reverse_proxy {$BACKEND_URL:http://app:8000}
	}

	handle /auth/* {
		reverse_proxy {$BACKEND_URL:http://app:8000}
	}

	# Static assets must retain normal file-server semantics. In particular, a
	# missing asset returns 404 without being replaced by the SPA document.
	handle /static/* {
		root * /srv
		file_server
	}

	# Registered Staff portal document routes serve the SPA shell with 200.
	@spa_routes {
		path / /callback /forms /create /reserve /my-reservations /approvals /roles /users /access-requests /business-areas /prefixes /admin/cms/pages /admin/cms/redirects /forms/* /edit/* /reservations/* /roles/* /users/* /access-requests/* /business-areas/* /prefixes/* /admin/cms/pages/*
	}

	handle @spa_routes {
		root * /srv
		rewrite * /index.html
		file_server
	}

	# Retired and non-existing document routes render the SPA Not Found view,
	# but retain the correct HTTP status for clients, crawlers, and monitoring.
	handle {
		root * /srv
		rewrite * /index.html
		file_server {
			status 404
		}
	}

	# Caddy access logs
	log {
		output stdout
		format filter {
			request>uri query {
				replace code REDACTED
				replace state REDACTED
				replace session_state REDACTED
			}
			wrap json
		}
	}
}

# ── Health port: used by Kubernetes probes only (no WAF) ─────────────────────
:3001 {
	handle /healthz {
		respond "OK" 200
	}
}
